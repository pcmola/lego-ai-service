# == Azure Foundry 리소스 ==
AOAI_ENDPOINT=YOUR_ENDPOINT
AOAI_API_KEY=YOUR_KEY
AOAI_API_VERSION=2024-02-01

# == Chat 모델 배포 ==
# 기본 모델 (빠르고 저렴)
AOAI_DEPLOY_CHAT=gpt-5.6-luna

# 고성능 모델
AOAI_DEPLOY_CHAT_PRO=gpt-6-sol

# 고성능 모델을 쓸 에이전트 (쉼표 구분: REQUIREMENTS, DESIGN, REFINER, BLUEPRINT(조립 도안) / 비우면 전부 기본 모델)
AOAI_PRO_AGENTS=

# LLM temperature (비우면 모델 기본값 사용)
# gpt-5.x 등 추론형 모델은 0.7 같은 값을 거부하므로 반드시 비워 둘 것
AOAI_TEMPERATURE=

# == Embedding 모델 배포 ==
AOAI_DEPLOY_EMBED_3_LARGE=text-embedding-3-large
AOAI_DEPLOY_EMBED_3_SMALL=
AOAI_DEPLOY_EMBED_ADA=

# REBRICKABLE_API 사용
REBRICKABLE_API_KEY=YOUR_KEY
REBRICKABLE_API_BASE=https://rebrickable.com/api/v3

# == 이미지 생성 (완성 예상 이미지) ==
# 비우면 이미지 기능 비활성화. 엔드포인트/키를 비우면 위 AOAI_ENDPOINT / AOAI_API_KEY 사용
AOAI_DEPLOY_IMAGE=
AOAI_IMAGE_ENDPOINT=
AOAI_IMAGE_API_KEY=
AOAI_IMAGE_API_VERSION=2025-04-01-preview
# low | medium | high (품질↑ = 시간/비용↑)
AOAI_IMAGE_QUALITY=low
